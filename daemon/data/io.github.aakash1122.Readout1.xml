<!DOCTYPE node PUBLIC "-//freedesktop//DTD D-BUS Object Introspection 1.0//EN"
 "http://www.freedesktop.org/standards/dbus/1.0/introspect.dtd">
<!--
  Readout system monitor service, version 1 of the interface.
  Full documentation of every payload key: docs/dbus-api.md
-->
<node>
  <interface name="io.github.aakash1122.Readout1">
    <!-- Static facts: version, module list, and one a{sv} per module (CPU model, GPUs, disks, sensors). -->
    <method name="GetInfo">
      <arg name="info" type="a{sv}" direction="out"/>
    </method>
    <!--
      Sets (replaces) the caller's subscription.
      modules: module name -> "none" | "panel" | "detail".
      interval_ms: clamped to 500..60000.
      options: "sensors" (as) = sensor ids the panel shows.
      Subscribing with every module set to "none" unsubscribes.
    -->
    <method name="Subscribe">
      <arg name="modules" type="a{ss}" direction="in"/>
      <arg name="interval_ms" type="u" direction="in"/>
      <arg name="options" type="a{sv}" direction="in"/>
    </method>
    <method name="Unsubscribe"/>
    <!-- Recent values per series, oldest first: series name -> [(monotonic time in µs, value)]. -->
    <method name="GetHistory">
      <arg name="module" type="s" direction="in"/>
      <arg name="series" type="a{sa(td)}" direction="out"/>
    </method>
    <!-- Sent only to the subscriber (unicast) on its interval. timestamp is CLOCK_MONOTONIC in µs. -->
    <signal name="Update">
      <arg name="timestamp" type="t"/>
      <arg name="modules" type="a{sa{sv}}"/>
    </signal>
    <property name="Version" type="s" access="read"/>
    <property name="SubscriberCount" type="u" access="read"/>
  </interface>
</node>
